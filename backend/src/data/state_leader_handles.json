{
  "_meta": {
    "purpose": "Official social-media accounts of Chhattisgarh leaders, parties and government bodies. Merge into politicalData.js / politicalEntities.js so the sentiment pipeline recognises a leader when a post names the handle and when the leader/party is the AUTHOR.",
    "researched": "2026-09-26. X bios read directly via api.fxtwitter.com (public profile JSON); Instagram/Facebook/YouTube read via their public og: metadata; cross-checked with Wikidata (P2002/P2003/P2013/P2397), official websites (dprcg.gov.in, cmo.cg.gov.in, opchoudhary.org, amitjogi.in) and search results.",
    "status": "CONFIRMED = official source (government/party site link, Wikidata + matching bio, or X 'government' affiliation badge + matching bio); LIKELY = one decent source (usually the profile's own bio naming the person and office). Fan pages, parody accounts, namesakes and anything weaker than LIKELY are left out; notable look-alikes are called out in 'note'.",
    "keys": "people are keyed by cg_leaders.json id; other sitting MLAs 'ac:<lowercase alphanumeric ECI AC name>'; parties by party id; 'government' holds non-person official accounts (DPR, Vidhan Sabha). The CM's Office accounts are filed under vishnu-deo-sai, as Goa files @goacm under the CM.",
    "maintenance": "When a handle changes, edit it here with a source URL, then run `npm run test:sentiment`."
  },
